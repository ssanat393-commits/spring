# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# Never expose this key in client-side code or Vite VITE_* variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where CICADA 2026 is hosted (injected in Cloud Run).
APP_URL="http://localhost:3000"

# PORT: HTTP and WebSocket port (AI Studio & local dev default to 3000).
PORT="3000"

# CICADA_DB_PATH: Local SQLite database file path.
CICADA_DB_PATH="./data/cicada.db"

# CICADA_SESSION_SECRET: Secret used to sign local operator session tokens.
CICADA_SESSION_SECRET="replace-with-strong-random-secret"

# CICADA_AGENT_BOOTSTRAP_KEY: Optional pre-shared key for automated agent registration.
CICADA_AGENT_BOOTSTRAP_KEY="replace-with-agent-registration-secret"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS="http://localhost:3000"

# Optional Firebase Client Configuration (for Firebase Auth & Firestore sync)
# Leave blank to run with local SQLite authentication and storage.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
